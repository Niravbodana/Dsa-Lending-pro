# Use SQLite for local dev (no Docker needed)
DATABASE_URL=sqlite:///./dsa_lending.db
# For production with Docker:
# DATABASE_URL=postgresql://dsa_user:dsa_pass@localhost:5432/dsa_lending
REDIS_URL=redis://localhost:6379/0

# --- Security (required for production) ---
ENV=development
SECRET_KEY=change-me-in-production
ADMIN_PASSWORD=admin123
WEBHOOK_HMAC_SECRET=
# Comma-separated allowed browser origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Host header values your API accepts
TRUSTED_HOSTS=localhost,127.0.0.1
ADMIN_SESSION_HOURS=8

OTP_EXPIRY_SECONDS=300
MOCK_OTP=true

# Partner API keys — set these to enable real lender API calls
# PARTNER_HDFC_API_URL=https://api.hdfcbank.com/offers
# PARTNER_HDFC_API_KEY=your-key-here
# PARTNER_ICICI_API_URL=https://api.icicibank.com/offers
# PARTNER_ICICI_API_KEY=your-key-here
# --- Reel Engine (cinematic video production) ---
# VIDEO_PROVIDER=replicate
# REPLICATE_API_TOKEN=
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# IMAGE_PROVIDER=replicate
# ALLOW_EDGE_TTS_PREVIEW=false

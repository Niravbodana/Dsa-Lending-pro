# NeerCred Cinematic Reel Engine — provider configuration
# Defaults work WITHOUT any API keys (stock footage + Piper TTS)

# --- DEFAULT (no API keys needed) ---
VIDEO_PROVIDER=stock      # Free Mixkit photoreal stock footage
VOICE_PROVIDER=piper        # Local neural TTS (offline)
IMAGE_PROVIDER=stock        # Frames from stock footage
MUSIC_PROVIDER=local        # Licensed promo BGM library

